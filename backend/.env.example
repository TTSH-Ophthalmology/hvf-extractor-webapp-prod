# Copy this file to .env and adjust values for your local environment.
# Never commit .env to version control.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Directory where uploaded PDFs are temporarily stored
UPLOAD_DIR=./data/uploads

# Comma-separated list of allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173"]

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where rotating log files are written
LOG_DIR=./data/logs

# TinyDB persistence file
DATABASE_PATH=./data/database.json

# Optional bootstrap values. Used only when TinyDB has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$4kpFQN2E/i8LSnKtSYwRVQ$9uWfF0rXh3Ri32Dlv9ji+agw82JQsrGHwg+bkuBat7U
JWT_SECRET_KEY=367980b48503d6ca5be1243280207bd4941b64687f3dfbfa2701e50e3c3f3913
COOKIE_SECURE=False
