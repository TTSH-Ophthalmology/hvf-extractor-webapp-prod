# Copy this file to .env and adjust values for your local environment.
# Never commit .env to version control.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Directory where uploaded PDFs are temporarily stored
UPLOAD_DIR=./data/uploads

# Comma-separated list of allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173"]

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where rotating log files are written
LOG_DIR=./data/logs

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
COOKIE_SECURE=